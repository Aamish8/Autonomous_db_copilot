# Copy this file to ".env" and fill in the values. Never commit ".env".

# Login for the web page (username is "demo")
DEMO_PASSWORD=choose-a-password

# Encrypts saved database passwords. Pick long random values and keep them forever:
# if they change, saved connections can no longer be decrypted.
COPILOT_CRYPTO_PASSWORD=replace-with-a-long-random-string
COPILOT_CRYPTO_SALT=050c54a9e58382f1

# Where Ollama runs.
# Ollama installed on your PC (default):
OLLAMA_URL=http://host.docker.internal:11434
# Ollama inside Docker (start with: docker compose --profile ollama up -d --build):
# OLLAMA_URL=http://ollama:11434
